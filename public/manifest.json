{
  "id": "/",
  "name": "NotaScribe Tablet - Notas, Stylus y Reconocimiento",
  "short_name": "NotaScribe",
  "description": "App de notas avanzada para tablets con escritura fluida con lápiz stylus, reconocimiento de escritura manuscrita y mapas conceptuales.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui",
    "tabbed"
  ],
  "orientation": "any",
  "theme_color": "#0f172a",
  "background_color": "#0f172a",
  "lang": "es",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "productivity",
    "education",
    "utilities"
  ],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app-icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Lienzo de dibujo stylus, cuadernos y organizador en tablet"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vista móvil de notas, tareas y reconocimiento"
    }
  ],
  "shortcuts": [
    {
      "name": "Nueva Nota Manuscrita",
      "short_name": "Nueva Nota",
      "description": "Crea una hoja en blanco para dibujar o escribir con stylus",
      "url": "/?action=new_note",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Diagramas y Mapas Conceptuales",
      "short_name": "Diagramas",
      "description": "Genera o explora mapas conceptuales de ideas",
      "url": "/?tab=diagrams",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Lista de Tareas",
      "short_name": "Tareas",
      "description": "Revisa tareas extraídas de notas manuscritas",
      "url": "/?tab=todos",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "note_taking": {
    "new_note_url": "/?action=new_note"
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/?action=open_file",
      "name": "Archivo de Notas NotaScribe",
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ],
      "accept": {
        "application/json": [".json"],
        "text/plain": [".txt"]
      }
    }
  ],
  "share_target": {
    "action": "/?action=share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+notescribe",
      "url": "/?note=%s"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "id": "com.notascribe.tablet"
    }
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "scope_extensions": [
    {
      "origin": "https://notaspersonalizadas.onrender.com"
    }
  ],
  "widgets": [
    {
      "name": "Notas Rápidas",
      "description": "Acceso rápido a tus notas y lápiz stylus",
      "tag": "quick-notes",
      "template": "widget-template",
      "data": "widget-data",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshot-narrow.png",
          "sizes": "750x1334",
          "label": "Widget de notas"
        }
      ],
      "icons": [
        {
          "src": "/pwa-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
